# #####################################
# Exit early if not interactive
# #####################################
# case $- in
#     *i*) ;;
#     *) return ;;
# esac

# Or:
# [ -z "$PS1" ] && return

# Optionally: only run in specific terminals
# [[ "$TERM_PROGRAM" == "vscode" ]] && do_something


# #####################################
# Load devbox tools
# #####################################
eval "$(devbox global shellenv --init-hook)"
if [[ -e "/home/antoine/.nix-profile/etc/profile.d/nix.sh" ]]
then
  # shellcheck disable=SC1091
  . "/home/antoine/.nix-profile/etc/profile.d/nix.sh"
fi # added by Nix installer

# #####################################
# Load autosuggestions
# #####################################
HISTSIZE=100000                    # lignes en mémoire dans la session
HISTFILESIZE=500000                # lignes dans le fichier .bash_history
HISTCONTROL=ignoredups:erasedups   # supprime les doublons
HISTTIMEFORMAT="%F %T "            # horodatage des commandes
shopt -s histappend                # append au lieu d'écraser à la fermeture du shell

# Fish-like autosuggestions for bash
# [[ -f "/home/antoine/.local/share/bash-autosuggestions/bash-autosuggestions.sh" ]] && source "/home/antoine/.local/share/bash-autosuggestions/bash-autosuggestions.sh"


# #####################################
# Load environment variables
# #####################################
# shellcheck disable=SC1091

# --- pass-based secret loading ---
# loadenv <name>  -> source secrets stored at env/<name>;  loadenv (no arg) lists them.
# loadenv() {
#   if [ -z "${1:-}" ]; then echo "Available:"; pass ls env 2>/dev/null | sed '1d'; return 0; fi
#   local out; out="$(pass show "env/$1")" || { echo "loadenv: no env/$1" >&2; return 1; }
#   source <(printf '%s\n' "$out")
# }
# _loadenv_complete() {
#   local cur="${COMP_WORDS[COMP_CWORD]}" d="${PASSWORD_STORE_DIR:-$HOME/.password-store}/env"
#   COMPREPLY=( $(compgen -W "$(cd "$d" 2>/dev/null && ls *.gpg 2>/dev/null | sed 's/\.gpg$//')" -- "$cur") )
# }
# complete -F _loadenv_complete loadenv

# --- auto-load ~/.bash_env secrets on every shell startup ---
# Secrets inside now come from `pass` (env/*); if the vault is locked this is a
# no-op decrypt failure per-var (empty value) rather than a hang, since gpg-agent
# is configured with pinentry-tty + preset-passphrase (see unlock-gpg above).
# [ -f "$HOME/.bash_env" ] && . "$HOME/.bash_env"

# #####################################
# Load aliases
# #####################################
# shellcheck disable=SC1091
. "$HOME/.bash_aliases"

# #####################################
# Load fzf completion
# #####################################
# Set up fzf key bindings and fuzzy completion
eval "$(fzf --bash)"
# shellcheck disable=SC1091
source "$(fzf-share)/key-bindings.bash"
# shellcheck disable=SC1091
source "$(fzf-share)/completion.bash"

# ############################################
# Prompt
# ############################################
eval "$(starship init bash)"


# fix ansible launch
# export LC_ALL="C.UTF-8"

# ############################################
# Commands to launch at each terminal start
# ############################################

# Switch OpenCode to VIO before 11am (cheaper/faster during off-peak)
# if [[ $((10#$(date +%H))) -lt 11 && "$(cat "$HOME/.last_opencode_vio_switch" 2>/dev/null)" != "$(date '+%Y%m%d')" ]]; then
#   opencode_switch_provider vio 2>/dev/null && date '+%Y%m%d' > "$HOME/.last_opencode_vio_switch"
# fi

# if [[ $(systemctl is-active cntlm) != "active" || $(systemctl is-active gost) != "active" || $(systemctl is-active wsl-vpnkit) != "active" ]]
# then
#   proxy_start
# fi

if [[ ! -f "$HOME/.last_update" || $(cat "$HOME/.last_update") -lt $(date -d '1 week ago' '+%s') ]]
then
  date '+%s' > "$HOME/.last_update"
  update
fi

if [[ ! -f "$HOME/.last_backup" || $(cat "$HOME/.last_backup") -lt $(date -d '1 day ago' '+%s') ]]
then
  date '+%s' > "$HOME/.last_backup"
  backup
fi

if [[ ! -f "$HOME/.last_free_space" || $(cat "$HOME/.last_free_space") -lt $(date -d '1 week ago' '+%s') ]]
then
  date '+%s' > "$HOME/.last_free_space"
  free_space
fi

if [[ ! -f "$HOME/.last_deleteOldBranches" || $(cat "$HOME/.last_deleteOldBranches") -lt $(date -d '1 day ago' '+%s') ]]
then
  date '+%s' > "$HOME/.last_deleteOldBranches"
  SILENT=1 deleteOldBranchesInEachRepo
fi

# abandonned for perfomance issue : if ! aws sts get-caller-identity --profile sfa > /dev/null 2>&1
if [[ ! -f "$HOME/.last_sfa_login" || $(cat "$HOME/.last_sfa_login") != "$(date '+%Y%m%d')" ]]
then
  read -r -p "Ready to launch sfa login? Press y to continue (Ctrl+C to skip): " -n 1 -s
  echo
  [[ $REPLY == "y" || $REPLY == "Y" ]] || return
  sfa
  aws sts get-caller-identity --profile sfa > /dev/null 2>&1 && date '+%Y%m%d' > "$HOME/.last_sfa_login"
fi
